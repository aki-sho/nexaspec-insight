{
  "name": "nexaspec-insight",
  "productName": "NexaSpec Insight",
  "version": "1.2.0",
  "description": "Windows PC specifications and system information viewer",
  "author": "akisho",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:security": "node scripts/run-security-tests.cjs",
    "build": "electron-builder --win --x64",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "systeminformation": "^5.33.23"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.example.pcspectool",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer/**/*",
      "templates/**/*",
      "services/**/*",
      "styles/**/*",
      "assets/nexaspec-insight.ico",
      "assets/nexaspec-insight.png"
    ],
    "win": {
      "icon": "assets/nexaspec-insight.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "NexaSpec-Insight-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "NexaSpec Insight",
      "uninstallDisplayName": "NexaSpec Insight",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "NexaSpec-Insight-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
